{
  "name": "Profile",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "age": {
      "type": "number"
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female"
      ]
    },
    "weight": {
      "type": "number"
    },
    "height": {
      "type": "number"
    },
    "target_weight": {
      "type": "number"
    },
    "activity_level": {
      "type": "string",
      "enum": [
        "sedentary",
        "light",
        "moderate",
        "active",
        "very_active"
      ]
    },
    "goal": {
      "type": "string",
      "enum": [
        "lose",
        "maintain",
        "gain"
      ]
    },
    "daily_calories": {
      "type": "number"
    },
    "protein_target": {
      "type": "number"
    },
    "carbs_target": {
      "type": "number"
    },
    "fat_target": {
      "type": "number"
    },
    "water_target": {
      "type": "number"
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "age",
    "gender",
    "weight",
    "height",
    "activity_level",
    "goal"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}